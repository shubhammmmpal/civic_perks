<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Civic Resume - {{name}}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@700&display=swap");

    body {
      font-family: "Inter", system_ui, sans-serif;
    }
    .header-font {
      font-family: "Playfair Display", sans-serif;
    }

    .pdf-container {
      max-width: 820px;
      margin: 2rem auto;
      background: white;
      box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
      border: 1px solid #e5e7eb;
      position: relative;
      overflow: hidden;
    }
    .watermark {
      position: absolute;
      top: 45%;
      left: -15%;
      transform: rotate(-28deg);
      font-size: 5.5rem;
      font-weight: 900;
      color: rgba(0, 0, 0, 0.09);
      pointer-events: none;
      white-space: nowrap;
      z-index: 10;
      letter-spacing: 12px;
    }
    .pro-seal {
      position: absolute;
      top: 140px;
      right: 50px;
      border: 4px solid #10b981;
      color: #10b981;
      padding: 10px 28px;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 700;
      transform: rotate(15deg);
      z-index: 20;
    }
    .action-item {
      border-left: 4px solid #10b981;
    }
  </style>
</head>
<body class="bg-gray-100 py-8">

  <div class="max-w-6xl mx-auto px-6">

    <!-- FREE TIER -->
    {{#if (eq reportType "FREE")}}
    <div class="pdf-container">
      <div class="watermark">CIVIC PERKS</div>

      <!-- HEADER -->
      <div class="border-b-2 border-black p-8 flex justify-between">
        <div>
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 bg-black rounded-2xl flex items-center justify-center text-white text-3xl">♻️</div>
            <div class="header-font text-2xl font-bold">CIVIC PERKS</div>
          </div>
          <div class="header-font text-4xl font-bold mt-6 leading-none">OFFICIAL RECORD<br />OF CIVIC IMPACT</div>
        </div>
        <div>
          <img src="{{qrCode}}" width="160" alt="QR Code" />
        </div>
      </div>

      <div class="p-8">
        <div class="flex justify-center mb-6">
          <span class="bg-amber-100 text-amber-700 px-5 py-1.5 rounded-full text-sm font-medium flex items-center gap-2">
            <i class="fa-solid fa-lock"></i>
            FREE TIER
          </span>
        </div>

        <div class="text-center mb-8">
          <div class="text-2xl font-medium">@{{nickname}}</div>
          <div class="text-xs text-gray-500 mt-1">Jan 1 – Dec 31, 2025</div>
        </div>

        <!-- Hero Metrics -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
          <div class="bg-white border p-5 rounded-3xl text-center">
            <div class="text-4xl font-bold">{{totalHoursServed}}</div>
            <div class="text-xs text-gray-500">Volunteer Hours</div>
          </div>
          <div class="bg-white border p-5 rounded-3xl text-center">
            <div class="text-4xl font-bold">Level {{level}}</div>
            <div class="text-xs text-gray-500">Current Level</div>
          </div>
          <div class="bg-white border p-5 rounded-3xl text-center">
            <div class="text-4xl font-bold">{{totalInterventions}}</div>
            <div class="text-xs text-gray-500">Interventions</div>
          </div>
          <div class="bg-white border p-5 rounded-3xl text-center">
            <div class="text-4xl font-bold">{{trustScore}}%</div>
            <div class="text-xs text-gray-500">Trust Rating</div>
          </div>
        </div>

        <div class="text-center text-sm text-gray-500 py-8 border-t border-dashed">
          Full history and real name unlocked at Level 10
        </div>
      </div>

      <div class="bg-black text-white text-center py-6 text-xs">
        FREE TIER • WATERMARK ENABLED • LIMITED TO CURRENT WEEK
      </div>
    </div>
    {{/if}}

    <!-- HIGH TIER -->
    {{#if (eq reportType "HIGH")}}
    <div class="pdf-container">
      <div class="watermark">CIVIC PERKS</div>

      <!-- HEADER -->
      <div class="border-b-2 border-black p-8 flex justify-between">
        <div>
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 bg-black rounded-2xl flex items-center justify-center text-white text-3xl">♻️</div>
            <div class="header-font text-2xl font-bold">CIVIC PERKS</div>
          </div>
          <div class="header-font text-4xl font-bold mt-6 leading-none">OFFICIAL RECORD<br />OF CIVIC IMPACT</div>
          <div class="mt-6">
            <div class="text-xl font-semibold">{{name}}</div>
            <div class="text-gray-600">@{{nickname}}</div>
          </div>
        </div>
        <div>
          <img src="{{qrCode}}" width="160" alt="QR Code" />
        </div>
      </div>

      <div class="p-8">
        <div class="flex justify-center mb-8">
          <span class="bg-emerald-100 text-emerald-700 px-6 py-2 rounded-full text-sm font-medium flex items-center gap-2">
            <i class="fa-solid fa-trophy"></i>
            HIGH LEVEL REPORT — LEVEL {{level}}
          </span>
        </div>

        <!-- Hero Metrics -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
          <div>
            <div class="text-5xl font-bold">{{totalHoursServed}}</div>
            <div class="text-sm text-gray-500">Verified Hours</div>
          </div>
          <div>
            <div class="text-5xl font-bold">{{totalInterventions}}</div>
            <div class="text-sm text-gray-500">Total Interventions</div>
          </div>
          <div>
            <div class="text-5xl font-bold">{{trustScore}}%</div>
            <div class="text-sm text-gray-500">Trust & Accuracy</div>
          </div>
        </div>

        <!-- RECENT VALIDATED ACTIONS -->
{{#if recentActions.length}}
<h3 class="font-semibold mb-4">RECENT VALIDATED ACTIONS</h3>
<div class="space-y-4">
  {{#each recentActions}}
  <div class="action-item pl-4 border-l-4 py-4 bg-gray-50 rounded-2xl">
    <div class="flex justify-between items-start">
      <div>
        <div class="font-medium">{{title}}</div>
        <div class="text-sm text-gray-600 mt-1">{{description}}</div>
      </div>
      <div class="text-right text-xs">
        <span class="px-3 py-1 rounded-full 
          {{#if (eq status "green")}}bg-green-100 text-green-700
          {{else if (eq status "orange")}}bg-amber-100 text-amber-700
          {{else}}bg-red-100 text-red-700{{/if}}">
          {{status}}
        </span>
      </div>
    </div>

    <div class="flex gap-4 text-xs mt-3 text-gray-500">
      <div><strong>Validated by:</strong> @{{validator}}</div>
      <div><strong>Date:</strong> {{date}}</div>
    </div>

    {{#if beneficiaries.length}}
    <div class="mt-2 text-xs">
      <strong>Beneficiaries:</strong> 
      {{#each beneficiaries}}
        @{{this}}{{#unless @last}}, {{/unless}}
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{/each}}
</div>
{{/if}}

        <!-- You can expand this section with more dynamic data later -->
      </div>

      <div class="bg-amber-600 text-white text-center py-6 text-xs font-medium">
        HIGH-LEVEL EARNED RESUME • WATERMARK ACTIVE
      </div>
    </div>
    {{/if}}

    <!-- PRO TIER -->
    {{#if (eq reportType "PRO")}}
    <div class="pdf-container">
      <div class="pro-seal">✓ VERIFIED PROFESSIONAL</div>

      <!-- HEADER -->
      <div class="border-b-2 border-black p-8 flex justify-between items-start">
        <div>
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-black rounded-2xl flex items-center justify-center text-white text-4xl">♻️</div>
            <div class="header-font text-3xl font-bold">CIVIC PERKS</div>
          </div>
          <div class="header-font text-4xl font-bold mt-8 leading-none">OFFICIAL RECORD<br />OF CIVIC IMPACT</div>
        </div>
        <div class="text-right">
          <img src="{{qrCode}}" width="160" alt="QR Code" />
        </div>
      </div>

      <div class="p-8">
        <div class="flex justify-between">
          <div>
            <div class="text-3xl font-semibold">{{name}}</div>
            <div class="flex items-center gap-4 text-sm">
              <span>@{{nickname}}</span>
              <span class="text-emerald-600">• Level {{level}}</span>
            </div>
            <div class="mt-2 text-sm">{{email}}</div>
          </div>
          <div class="text-right text-sm">
            <!-- Date Range Display -->
            <div class="text-center mb-6">
              <div class="inline-flex items-center gap-2 bg-gray-100 px-5 py-2 rounded-3xl text-sm">
                <i class="fa-solid fa-calendar"></i>
                <span>
                  {{#if startDate}}
                    {{startDate}} — {{endDate}}
                  {{else}}
                    {{#if (eq reportType "FREE")}}
                      Last 7 Days
                    {{else}}
                      Full Year Report
                    {{/if}}
                  {{/if}}
                </span>
              </div>
            </div>         
          </div>
        </div>

        <!-- Hero Metrics -->
        <div class="grid grid-cols-4 gap-6 my-12">
          <div class="text-center bg-gray-50 rounded-3xl py-6">
            <div class="text-5xl font-bold">{{totalHoursServed}}</div>
            <div class="text-xs text-gray-500">HOURS</div>
          </div>
          <div class="text-center bg-gray-50 rounded-3xl py-6">
            <div class="text-5xl font-bold">{{totalInterventions}}</div>
            <div class="text-xs text-gray-500">ACTIONS</div>
          </div>
          <div class="text-center bg-gray-50 rounded-3xl py-6">
            <div class="text-5xl font-bold">{{trustScore}}%</div>
            <div class="text-xs text-gray-500">TRUST</div>
          </div>
        </div>

        <!-- RECENT VALIDATED ACTIONS -->
{{#if recentActions.length}}
<h3 class="font-semibold mb-4">RECENT VALIDATED ACTIONS</h3>
<div class="space-y-4">
  {{#each recentActions}}
  <div class="action-item pl-4 border-l-4 py-4 bg-gray-50 rounded-2xl">
    <div class="flex justify-between items-start">
      <div>
        <div class="font-medium">{{title}}</div>
        <div class="text-sm text-gray-600 mt-1">{{description}}</div>
      </div>
      <div class="text-right text-xs">
        <span class="px-3 py-1 rounded-full 
          {{#if (eq status "green")}}bg-green-100 text-green-700
          {{else if (eq status "orange")}}bg-amber-100 text-amber-700
          {{else}}bg-red-100 text-red-700{{/if}}">
          {{status}}
        </span>
      </div>
    </div>

    <div class="flex gap-4 text-xs mt-3 text-gray-500">
      <div><strong>Validated by:</strong> @{{validator}}</div>
      <div><strong>Date:</strong> {{date}}</div>
    </div>

    {{#if beneficiaries.length}}
    <div class="mt-2 text-xs">
      <strong>Beneficiaries:</strong> 
      {{#each beneficiaries}}
        @{{this}}{{#unless @last}}, {{/unless}}
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{/each}}
</div>
{{/if}}

        <!-- More sections can be added here -->
      </div>

      <div class="bg-black text-white p-8 text-xs">
        <div class="flex justify-between items-center">
          <div>Document ID: <span class="font-mono">CP-PRO-{{userId}}</span></div>
          <div>{{tier}} • Verified by Civic Perks</div>
        </div>
      </div>
    </div>
    {{/if}}

  </div>
</body>
</html>