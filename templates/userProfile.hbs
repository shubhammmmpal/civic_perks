<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 30px;
      color: #333;
    }

    .card {
      border: 1px solid #ddd;
      border-radius: 12px;
      padding: 24px;
    }

    .header {
      text-align: center;
      margin-bottom: 20px;
    }

    .profile-image {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
    }

    .row {
      margin: 10px 0;
      font-size: 16px;
    }

    .qr {
      margin-top: 20px;
      text-align: center;
    }

    .qr img {
      width: 180px;
      height: 180px;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="header">
      <h1>User Profile</h1>

      {{#if image}}
      <img class="profile-image" src="{{image}}" />
      {{/if}}
    </div>

    <div class="row"><strong>Name:</strong> {{name}}</div>
    <div class="row"><strong>Email:</strong> {{email}}</div>
    <div class="row"><strong>Nickname:</strong> {{nickname}}</div>
    <div class="row"><strong>Trust Score:</strong> {{trustScore}}</div>
    <div class="row"><strong>Level:</strong> {{level}}</div>
    <div class="row"><strong>Tier:</strong> {{tier}}</div>

    <div class="qr">
      <h3>QR Code</h3>
      <img src="{{qrCode}}" />
    </div>
  </div>
</body>
</html>